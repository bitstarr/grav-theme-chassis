{% spaceless %}
{% set baseImage = image.cropResize(640,null).quality(70).url %}
{% if isNarrow %}
    {# narrow width #}
    {% set imageset = {
        960: image.cropResize(960,null).quality(70).url,
    } %}
{% elseif header.layout.spread == 'full' %}
    {# full screen width #}
    {% set imageset = {
        550: image.cropResize(960,null).quality(70).url,
        960: image.cropResize(1280,null).quality(70).url,
        1280: image.cropResize(1920,null).quality(70).url,
        1920: image.cropResize(2560,null).quality(70).url,
    } %}
{% elseif header.layout.spread == 'mid' %}
    {# broken out of wrapper #}
    {% set imageset = {
        550: image.cropResize(960,null).quality(70).url,
        1280: image.cropResize(1280,null).quality(70).url,
        1920: image.cropResize(1920,null).quality(70).url,
    } %}
{% else %}
    {# wrapper wide width #}
    {% set imageset = {
        550: image.cropResize(960,null).quality(70).url,
        1440: image.cropResize(1280,null).quality(70).url,
        1920: image.cropResize(1440,null).quality(70).url,
    } %}
{% endif %}
{% endspaceless %}

{% if imageset|length == 1 -%}
<img class="image"
    src="{{ baseImage }}"
    width=640
    height={{ ( image.height / image.width * 640)|round }}
    alt="{{ image.metadata.alt }}"
    loading="lazy"
    decoding="async"
    >
{% else -%}
<picture>
    {% if imageset -%}
        <source srcset="{{ baseImage }}" media="(max-width: 549px)">
        {% for breakpoint, source in imageset|reverse -%}
            <source srcset="{{ source }}" media="(min-width: {{ breakpoint }}px)">
        {% endfor -%}
    {% endif -%}
    <img class="image"
        src="{{ baseImage }}"
        width=640
        height={{ ( image.height / image.width * 640)|round }}
        alt="{{ image.metadata.alt }}"
        loading="lazy"
        decoding="async"
        >
</picture>
{% endif -%}