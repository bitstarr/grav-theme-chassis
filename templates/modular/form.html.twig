{% spaceless %}
{% set modular_classes = [
    'modular',
    'wrapping',
] %}

{% if header.id %}
    {% set id = ' id="' ~ header.id ~ '"' %}
{% endif %}
{% if header.layout_alt %}
    {% set modular_classes = modular_classes|merge( ['modular--alt'] ) %}
{% endif %}
{% endspaceless %}

<div class="{{ modular_classes|join( ' ' )|trim }}"{{ id|raw }}>
    {% if config.plugins.form.modular_form_fix %}
        {% include "forms/form.html.twig" with {form: forms({route: page.route})} %}
    {% else %}
        {% include "forms/form.html.twig" %}
    {% endif %}
</div>