{% spaceless %}
{% set modular_classes = [
    'modular',
    'wrapping',
] %}
{% endspaceless %}
<div class="{{ modular_classes|join( ' ' )|trim }}">
    <style>
    .icongrid {
        columns: 12em;

        dd, dt {
            margin: 0;
        }

        .item {
            display: flex;
            align-items: center;
            gap: 1ex;
            padding: 1ex 0;
        }

        .icon {
            fill: currentcolor;
            height: 1em;
            width: 1em;
            overflow: hidden;
            vertical-align: -.125em;
            forced-color-adjust: auto;
            font-size: 1.8em;
        }
    }
    </style>
    {% set icons = chassis.getIcons() %}
    <dl class="icongrid">
    {% for icon in icons %}
        <div class="item">
            <dd>
                {{ svg(icon)|raw }}
            </dd>
            <dt>
                {{ icon }}
            </dt>
        </div>
    {% endfor %}
    </dl>
</div>
